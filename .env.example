# Server secrets for src/pages/api, declared in astro.config.mjs (env.schema).

# Resend (https://resend.com): verify the amaurygomez.dev domain first
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="Amaury Gómez <hello@amaurygomez.dev>"
CONTACT_TO=hello@amaurygomez.dev

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
PUBLIC_TURNSTILE_SITE_KEY=0xAAAAAAAAAAAAAAAAAAAAAA
TURNSTILE_SECRET_KEY=0xBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# Upstash Redis (https://upstash.com): REST credentials for rate limiting
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Vercel Cron sends it as a Bearer token to /api/cron/keepalive (openssl rand -hex 32).
CRON_SECRET=

# Decrypts sealed/cv.*.pdf.enc: 32 random bytes, base64 (openssl rand -base64 32).
# Keep it in .env.local for npm run cv:seal and set the same value on Vercel.
CV_FULL_KEY=
