                  {tr("e2.t")}
                </span>
                <span class="org" data-i="e2.o">
                  {tr("e2.o")}
                </span>
              </li>
              <li class="tl reveal" style="--d:120ms">
                <span class="role" data-i="e3.r">
                  {tr("e3.r")}
                </span>
                <span class="ten" data-i="e3.t">
                  {tr("e3.t")}
                </span>
                <span class="org" data-i="e3.o">
                  {tr("e3.o")}
                </span>
              </li>
              <li class="tl reveal" style="--d:180ms">
                <span class="role" data-i="e4.r">
                  {tr("e4.r")}
                </span>
                <span class="ten" data-i="e4.t">
                  {tr("e4.t")}
                </span>
