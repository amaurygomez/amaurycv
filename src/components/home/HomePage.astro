---
// Home, the brand page, rendered once per language: / in Spanish and /en in English.
// AG World, the interactive portfolio, lives at /world.
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import worldEn from "@/assets/world/overview.en.webp";
import worldEs from "@/assets/world/overview.es.webp";
import PersonSchema from "@/components/astro/PersonSchema.astro";
import type { Lang } from "@/i18n/content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { faq } from "@/scripts/home/faq.js";
import { I18N } from "@/scripts/home/i18n.js";
import "@/styles/home.css";
import "@/styles/home-hero.css";
import "@/styles/home-projects.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy: Record<Lang, Record<string, string>> = I18N;
const tr = (key: string) => copy[lang][key] ?? copy.es[key] ?? "";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: faq[lang].map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout
  title={tr("meta.title")}
  description={tr("hero.sub")}
  lang={lang}
  alternates={{ es: "/", en: "/en" }}
  lockScroll={false}
  bodyClass="home"
  colorScheme="light dark"
  themeColor="#FAFAF9"
  siteName="Amaury Gómez"
>
  <Fragment slot="head">
    <script is:inline>
      try {
        if (localStorage.getItem("ag-theme") === "dark")
          document.documentElement.dataset.theme = "dark";
      } catch {
        // Storage is unavailable in private mode; the light default stands.
      }
    </script>
    <PersonSchema />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <a class="skip" href="#servicios" data-i="skip">
    {tr("skip")}
  </a>
  <header class="nav" id="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top" aria-label={tr("brand.aria")} data-i-aria="brand.aria">
        <svg
          class="mono-mark"
          viewBox="0 0 32 32"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2.5 26L10 6l7.5 20M6 19h8" />
          <path d="M28.95 11.05A7 7 0 1 0 31 16h-7" />
        </svg>
        <span>
          <span class="wordmark">Amaury Gómez</span>
          <span class="descriptor" data-i="brand.desc">
            {tr("brand.desc")}
          </span>
        </span>
      </a>
      <nav class="nav-links" aria-label={tr("nav.main")} data-i-aria="nav.main">
        <a href="#servicios" data-spy="servicios" data-i="nav.services">
          {tr("nav.services")}
        </a>
        <a href="#proyectos" data-spy="proyectos" data-i="nav.projects">
          {tr("nav.projects")}
        </a>
        <a href="#enfoque" data-spy="enfoque" data-i="nav.approach">
          {tr("nav.approach")}
        </a>
        <a href="#proceso" data-spy="proceso" data-i="nav.process">
          {tr("nav.process")}
        </a>
        <a href="#fundador" data-spy="fundador" data-i="nav.founder">
          {tr("nav.founder")}
        </a>
        <a href="#contacto" data-spy="contacto" data-i="nav.contact">
          {tr("nav.contact")}
        </a>
        <span class="nav-ind" id="nav-ind" aria-hidden="true"></span>
      </nav>
      <div class="nav-actions">
        <div class="lang" role="group" aria-label={tr("nav.lang")} data-i-aria="nav.lang">
          <button type="button" class="lang-btn" data-lang="es" aria-pressed={lang === "es"}>
            ES
          </button>
          <span class="lang-sep" aria-hidden="true">
            /
          </span>
          <button type="button" class="lang-btn" data-lang="en" aria-pressed={lang === "en"}>
            EN
          </button>
        </div>
        <button
          type="button"
          class="icon-btn"
          id="theme-btn"
          aria-label={tr("nav.theme")}
          data-i-aria="nav.theme"
        >
          <svg
            class="ico-sun"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg
            class="ico-moon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
        </button>
        <a class="btn btn-primary btn-sm nav-cta" href="#contacto" data-i="nav.talk">
          {tr("nav.talk")}
        </a>
        <button
          type="button"
          class="icon-btn menu-btn"
          id="menu-btn"
          aria-label={tr("nav.menu")}
          data-i-aria="nav.menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            class="ico-bars"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg
            class="ico-x"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
    </div>
    <div class="mobile-menu" id="mobile-menu">
      <a href="#servicios" data-i="nav.services">
        {tr("nav.services")}
      </a>
      <a href="#proyectos" data-i="nav.projects">
        {tr("nav.projects")}
      </a>
      <a href="#enfoque" data-i="nav.approach">
        {tr("nav.approach")}
      </a>
      <a href="#proceso" data-i="nav.process">
        {tr("nav.process")}
      </a>
      <a href="#fundador" data-i="nav.founder">
        {tr("nav.founder")}
      </a>
      <a href="#contacto" data-i="nav.contact">
        {tr("nav.contact")}
      </a>
      <a class="btn btn-primary" href="#contacto" data-i="nav.talk">
        {tr("nav.talk")}
      </a>
    </div>
    <span class="progress" id="progress" aria-hidden="true"></span>
  </header>

  <main id="top">
    <section class="hero" id="hero">
      <div class="hero-scene" id="hero-scene" aria-hidden="true">
        <canvas id="hero-canvas"></canvas>
      </div>
      <div class="hero-veil" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="chip">
            <span class="dot" aria-hidden="true"></span>
            <span data-i="hero.chip">{tr("hero.chip")}</span>
          </p>
          <h1 class="hero-h1" id="hero-h1">
            {tr("hero.h1")}
          </h1>
          <p class="hero-sub" data-i="hero.sub">
            {tr("hero.sub")}
          </p>
          <div class="hero-cta">
            <a class="btn btn-primary" href="#contacto">
              <span data-i="hero.cta1">{tr("hero.cta1")}</span>
              <svg
                class="arr"
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
            <a class="btn btn-secondary" href="#proyectos">
              <span data-i="hero.cta2">{tr("hero.cta2")}</span>
            </a>
          </div>
          <div class="hero-trust">
            <span class="hero-trust-label" data-i="hero.trust">
              {tr("hero.trust")}
            </span>
            <ul class="hero-trust-list">
              <li>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0" />
                  <circle cx="12" cy="20" r="1" fill="currentColor" />
                </svg>
                <span data-i="hero.t1">{tr("hero.t1")}</span>
              </li>
              <li>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 21h18M4 21V10M20 21V10M2 10l10-6 10 6M8 21v-7M12 21v-7M16 21v-7" />
                </svg>
                <span data-i="hero.t2">{tr("hero.t2")}</span>
              </li>
              <li>
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="11" width="18" height="10" rx="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                <span data-i="hero.t3">{tr("hero.t3")}</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div class="hero-scroll" aria-hidden="true">
        <span class="hero-scroll-line"></span>
        <span class="hero-scroll-txt" data-i="hero.scroll">
          {tr("hero.scroll")}
        </span>
      </div>
    </section>

    <section class="metrics" aria-label={tr("metrics.aria")} data-i-aria="metrics.aria">
      <div class="wrap">
        <ul class="metric-grid">
          <li class="metric">
            <span class="num" data-target="11" data-suffix="+">
              11+
            </span>
            <span class="label" data-i="m1">
              {tr("m1")}
            </span>
          </li>
          <li class="metric">
            <span class="num" data-target="24" data-suffix="/7">
              24/7
            </span>
            <span class="label" data-i="m2">
              {tr("m2")}
            </span>
          </li>
          <li class="metric">
            <span class="num" data-target="3">
              3
            </span>
            <span class="label" data-i="m3">
              {tr("m3")}
            </span>
          </li>
          <li class="metric">
            <span class="num" data-static>
              ES · EN
            </span>
            <span class="label" data-i="m4">
              {tr("m4")}
            </span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" id="servicios">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="label" data-i="svc.eyebrow">
              {tr("svc.eyebrow")}
            </span>
            <h2 class="reveal reveal-clip" data-i="svc.title">
              {tr("svc.title")}
            </h2>
            <p class="sec-sub" data-i="svc.sub">
              {tr("svc.sub")}
            </p>
          </div>
        </div>
        <div class="svc-grid">
          <article class="svc reveal">
            <span class="idx">01</span>
            <div class="ico">
              <svg
                viewBox="0 0 40 40"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="i-stack"
                aria-hidden="true"
              >
                <rect class="m1" x="6" y="6" width="28" height="8" rx="2" />
                <rect class="m2" x="6" y="16" width="28" height="8" rx="2" />
                <rect class="m3" x="6" y="26" width="28" height="8" rx="2" />
                <circle class="m4" cx="29" cy="20" r="1.6" fill="currentColor" stroke="none" />
              </svg>
            </div>
            <h3 data-i="svc1.h">{tr("svc1.h")}</h3>
            <p data-i="svc1.p">{tr("svc1.p")}</p>
          </article>
          <article class="svc reveal" style="--d:80ms">
            <span class="idx">02</span>
            <div class="ico">
              <svg
                viewBox="0 0 40 40"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="i-ref"
                aria-hidden="true"
              >
                <path class="m1" d="M32 20a12 12 0 0 1-20.5 8.5M8 20A12 12 0 0 1 28.5 11.5" />
                <path class="m2" d="M28.5 6v5.5H23M11.5 34v-5.5H17" />
              </svg>
            </div>
            <h3 data-i="svc2.h">{tr("svc2.h")}</h3>
            <p data-i="svc2.p">{tr("svc2.p")}</p>
          </article>
          <article class="svc reveal" style="--d:160ms">
            <span class="idx">03</span>
            <div class="ico">
              <svg
                viewBox="0 0 40 40"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="i-link"
                aria-hidden="true"
              >
                <rect class="m1" x="4" y="13" width="12" height="14" rx="3" />
                <rect class="m2" x="24" y="13" width="12" height="14" rx="3" />
                <path class="m3" d="M16 20h8" />
                <circle cx="10" cy="20" r="1.6" fill="currentColor" stroke="none" />
                <circle cx="30" cy="20" r="1.6" fill="currentColor" stroke="none" />
              </svg>
            </div>
            <h3 data-i="svc3.h">{tr("svc3.h")}</h3>
            <p data-i="svc3.p">{tr("svc3.p")}</p>
          </article>
          <article class="svc reveal" style="--d:240ms">
            <span class="idx">04</span>
            <div class="ico">
              <svg
                viewBox="0 0 40 40"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="i-data"
                aria-hidden="true"
              >
                <ellipse class="m1" cx="14" cy="9" rx="9" ry="3.5" />
                <path d="M5 9v10c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9M5 19v10c0 1.9 4 3.5 9 3.5" />
                <path class="m2" d="M26 33v-6" />
                <path class="m3" d="M30.5 33v-9" />
                <path class="m4" d="M35 33V21" />
              </svg>
            </div>
            <h3 data-i="svc4.h">{tr("svc4.h")}</h3>
            <p data-i="svc4.p">{tr("svc4.p")}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="proyectos">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="label" data-i="proj.eyebrow">
              {tr("proj.eyebrow")}
            </span>
            <h2 class="reveal reveal-clip" data-i="proj.title">
              {tr("proj.title")}
            </h2>
          </div>
          <span class="sec-note" data-i="proj.note">
            {tr("proj.note")}
          </span>
        </div>
        <div class="story" id="story">
          <div class="story-stage">
            <nav class="story-rail" aria-label={tr("proj.eyebrow")} data-i-aria="proj.eyebrow">
              <span class="story-count" aria-hidden="true">
                <span class="story-cur" id="story-cur">
                  01
                </span>
                <span class="story-sep">/ 03</span>
              </span>
              <span class="story-bar" aria-hidden="true"></span>
              <ol class="story-index">
                <li>
                  <button type="button" class="story-jump" data-step="0" aria-current="true">
                    <span class="n">01</span>
                    <span class="t" data-i="p1.h">
                      {tr("p1.h")}
                    </span>
                  </button>
                </li>
                <li>
                  <button type="button" class="story-jump" data-step="1">
                    <span class="n">02</span>
                    <span class="t" data-i="p2.h">
                      {tr("p2.h")}
                    </span>
                  </button>
                </li>
                <li>
                  <button type="button" class="story-jump" data-step="2">
                    <span class="n">03</span>
                    <span class="t" data-i="p3.h">
                      {tr("p3.h")}
                    </span>
                  </button>
                </li>
              </ol>
            </nav>

            <article class="story-item" id="proj-1">
              <div class="story-fig" data-chrome="crm / coverage-map">
                <svg
                  class="dg"
                  id="d1"
                  viewBox="0 0 520 390"
                  role="img"
                  aria-label={tr("d1.aria")}
                  data-i-aria="d1.aria"
                ></svg>
              </div>
              <div class="story-body">
                <span class="story-num">01 / 03</span>
                <span class="label" data-i="p1.tag">
                  {tr("p1.tag")}
                </span>
                <h3 data-i="p1.h">{tr("p1.h")}</h3>
                <p data-i="p1.p">{tr("p1.p")}</p>
                <ul class="stack">
                  <li>.NET</li>
                  <li>Oracle</li>
                  <li>Angular</li>
                  <li>Google Maps</li>
                </ul>
              </div>
            </article>

            <article class="story-item" id="proj-2">
              <div class="story-fig" data-chrome="identity / gateway">
                <svg
                  class="dg"
                  id="d2"
                  viewBox="0 0 520 390"
                  role="img"
                  aria-label={tr("d2.aria")}
                  data-i-aria="d2.aria"
                >
                  <defs>
                    <linearGradient id="g2-mw" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="var(--primary)" stop-opacity=".10" />
                      <stop offset=".3" stop-color="var(--primary)" stop-opacity="0" />
                    </linearGradient>
                    <radialGradient id="g2-pk">
                      <stop offset="0" stop-color="#fff" stop-opacity=".9" />
                      <stop offset=".35" stop-color="var(--primary)" />
                      <stop offset="1" stop-color="var(--primary)" stop-opacity="0" />
                    </radialGradient>
                    <radialGradient id="g2-pka">
                      <stop offset="0" stop-color="#fff" stop-opacity=".9" />
                      <stop offset=".35" stop-color="var(--accent)" />
                      <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
                    </radialGradient>
                  </defs>
                  <path class="wire" id="d2-p1" d="M160 82 C 184 82, 184 118, 208 118" />
                  <path class="wire" id="d2-p2" d="M160 195 L 208 195" />
                  <path class="wire" id="d2-p3" d="M160 308 C 184 308, 184 272, 208 272" />
                  <path class="wire" id="d2-p4" d="M368 195 L 408 195" />
                  <path class="wire" id="d2-p5" d="M352 250 C 382 250, 382 206, 408 206" />
                  <g class="flows" id="d2-flows">
                    <path class="wire-flow" d="M160 82 C 184 82, 184 118, 208 118" />
                    <path class="wire-flow" d="M160 195 L 208 195" />
                    <path class="wire-flow" d="M160 308 C 184 308, 184 272, 208 272" />
                    <path class="wire-flow" d="M368 195 L 408 195" />
                    <path class="wire-flow flow-acc" d="M352 250 C 382 250, 382 206, 408 206" />
                  </g>
                  <g class="ext" id="d2-ext1">
                    <rect class="box" x="24" y="56" width="136" height="52" rx="10" />
                    <circle class="led" cx="38" cy="70" r="3" />
                    <text class="t-ink" x="92" y="86" text-anchor="middle" data-i="d2.api1">
                      {tr("d2.api1")}
                    </text>
                  </g>
                  <g class="ext" id="d2-ext2">
                    <rect class="box" x="24" y="169" width="136" height="52" rx="10" />
                    <circle class="led" cx="38" cy="183" r="3" />
                    <text class="t-ink" x="92" y="199" text-anchor="middle" data-i="d2.api2">
                      {tr("d2.api2")}
                    </text>
                    <text
                      class="dn-label t-dn"
                      x="92"
                      y="243"
                      text-anchor="middle"
                      data-i="d2.down"
                    >
                      {tr("d2.down")}
                    </text>
                  </g>
                  <g class="ext" id="d2-ext3">
                    <rect class="box" x="24" y="282" width="136" height="52" rx="10" />
                    <circle class="led" cx="38" cy="296" r="3" />
                    <text class="t-ink" x="92" y="312" text-anchor="middle" data-i="d2.api3">
                      {tr("d2.api3")}
                    </text>
                  </g>
                  <g id="d2-mw">
                    <rect class="box box-hero" x="208" y="44" width="160" height="302" rx="12" />
                    <rect x="209" y="45" width="158" height="300" rx="11" fill="url(#g2-mw)" />
                    <path
                      class="shield"
                      d="M288 54c-6 2.5-10 3.5-13 4v8c0 7 6 11.5 13 14 7-2.5 13-7 13-14v-8c-3-.5-7-1.5-13-4z"
                    />
                    <path class="shield-tick" d="M282.5 65.5l4 4 7-7" />
                    <text class="t-ink t-lg" x="288" y="92" text-anchor="middle" data-i="d2.mw">
                      {tr("d2.mw")}
                    </text>
                    <rect class="pill" x="224" y="104" width="128" height="28" rx="7" />
                    <text x="288" y="122" text-anchor="middle" data-i="d2.auth1">
                      {tr("d2.auth1")}
                    </text>
                    <rect class="pill" x="224" y="138" width="128" height="28" rx="7" />
                    <text x="288" y="156" text-anchor="middle" data-i="d2.auth2">
                      {tr("d2.auth2")}
                    </text>
                    <g class="audit-rows">
                      <rect
                        class="audit-row"
                        x="232"
                        y="176"
                        width="112"
                        height="3"
