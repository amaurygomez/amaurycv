                  <path
                    d="M22 17v10M17 22h10"
                    stroke="currentColor"
                    stroke-width="1"
                    opacity=".7"
                  />
                </pattern>
              </defs>
              <rect width="400" height="500" fill="url(#crosses)" />
            </svg>
            <svg
              class="big-mark"
              viewBox="0 0 32 32"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2.5 26L10 6l7.5 20M6 19h8" />
              <path d="M28.95 11.05A7 7 0 1 0 31 16h-7" />
            </svg>
            <span class="tag" data-i="founder.tag">
              {tr("founder.tag")}
            </span>
          </div>
          <div class="founder-body">
            <span class="label" data-i="founder.eyebrow">
              {tr("founder.eyebrow")}
            </span>
            <h2 class="reveal reveal-clip">Amaury Gómez</h2>
            <p class="subtitle" data-i="founder.sub">
              {tr("founder.sub")}
            </p>
            <p class="bio" data-i="founder.bio">
