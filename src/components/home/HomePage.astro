    <section class="section contact" id="contacto">
      <div class="wrap">
        <div class="contact-grid">
          <div class="contact-intro">
            <span class="label" data-i="contact.eyebrow" style="display:block;margin-bottom:18px">
              {tr("contact.eyebrow")}
            </span>
            <h2 class="reveal reveal-clip" data-i="contact.h">
              {tr("contact.h")}
            </h2>
            <p class="contact-lead" data-i="contact.p">
              {tr("contact.p")}
            </p>
            <ul class="contact-points">
              <li>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                <span data-i="contact.b1">{tr("contact.b1")}</span>
              </li>
              <li>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                <span data-i="contact.b2">{tr("contact.b2")}</span>
              </li>
              <li>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                <span data-i="contact.b3">{tr("contact.b3")}</span>
              </li>
            </ul>
            <p class="contact-alt" data-i="contact.alt">
              {tr("contact.alt")}
            </p>
            <div class="email-row">
              <a class="email" data-email href="mailto:hello@amaurygomez.dev">
                hello@amaurygomez.dev
              </a>
              <button
                type="button"
                class="copy"
                data-copy
                aria-label={tr("contact.copyAria")}
                data-i-aria="contact.copyAria"
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="9" y="9" width="12" height="12" rx="2" />
                  <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                </svg>
                <span data-copy-label data-i="contact.copy">
                  {tr("contact.copy")}
                </span>
              </button>
            </div>
          </div>
          <!-- Hidden until the script confirms the form can send (it needs Turnstile); the email row always works. -->
          <div class="contact-card" id="contact-card" hidden>
            <form id="contact-form" novalidate>
              <div class="f-row">
                <div class="field">
                  <label for="cf-name" data-i="cf.name">
                    {tr("cf.name")}
                  </label>
                  <input
                    id="cf-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    required
                    minlength="2"
                    maxlength="80"
                  />
                </div>
                <div class="field">
                  <label for="cf-email" data-i="cf.email">
                    {tr("cf.email")}
                  </label>
                  <input
                    id="cf-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    inputmode="email"
                    required
                    maxlength="120"
                  />
                </div>
              </div>
              <div class="field">
                <label for="cf-type" data-i="cf.type">
                  {tr("cf.type")}
                </label>
                <select id="cf-type" name="type">
                  <option value="req.t1" data-i="req.t1">
                    {tr("req.t1")}
                  </option>
                  <option value="req.t2" data-i="req.t2">
                    {tr("req.t2")}
                  </option>
                  <option value="req.t3" data-i="req.t3">
                    {tr("req.t3")}
                  </option>
                  <option value="req.t4" data-i="req.t4">
                    {tr("req.t4")}
                  </option>
                  <option value="cf.t5" data-i="cf.t5">
                    {tr("cf.t5")}
                  </option>
                </select>
              </div>
              <div class="field">
                <label for="cf-message" data-i="cf.message">
                  {tr("cf.message")}
                </label>
                <textarea
                  id="cf-message"
                  name="message"
                  rows="5"
                  required
                  minlength="20"
                  maxlength="1800"
                  aria-describedby="cf-hint"
                ></textarea>
                <span class="field-hint" id="cf-hint" data-i="cf.hint">
                  {tr("cf.hint")}
                </span>
              </div>
              <div class="cf-trap" aria-hidden="true">
                <label for="cf-website">Website</label>
                <input
                  id="cf-website"
                  name="website"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>
              <div class="cf-captcha" data-turnstile></div>
              <p class="f-error" id="cf-error" role="alert"></p>
              <button type="submit" class="btn btn-primary cf-submit">
                <span data-submit-label data-i="cf.send">
                  {tr("cf.send")}
                </span>
                <svg
                  class="arr"
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </button>
              <p class="privacy" data-i="cf.privacy">
                {tr("cf.privacy")}
              </p>
            </form>
            <div class="contact-ok" id="contact-ok" role="status" tabindex="-1" hidden>
              <span class="contact-ok-ico">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </span>
              <h3 data-i="cf.okTitle">{tr("cf.okTitle")}</h3>
              <p data-i="cf.okText">{tr("cf.okText")}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

