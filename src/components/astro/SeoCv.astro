---
import { profile } from "@/i18n/content";
import { cv } from "@/i18n/cv";

// The world is client-only: without JavaScript this is the page, and /cv holds the full text.
const { headline, focus, profile: summary } = cv.es;
---

<noscript>
  <main class="mx-auto max-w-[40rem] px-5 py-16 text-ag-text">
    <h1 class="text-4xl font-semibold tracking-tight">{profile.shortName}</h1>
    <p class="mt-3 text-lg text-ag-text-muted">
      {headline} · {focus}
    </p>
    <p class="mt-8 leading-relaxed text-ag-text-muted">{summary}</p>
    <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
      <a class="underline underline-offset-4 hover:text-ag-gold" href="/cv?lang=es">
        Ver el CV
      </a>
      <a class="underline underline-offset-4 hover:text-ag-gold" href="/cv?lang=en" lang="en">
        Read the CV in English
      </a>
      <a class="underline underline-offset-4 hover:text-ag-gold" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
    </p>
  </main>
</noscript>
