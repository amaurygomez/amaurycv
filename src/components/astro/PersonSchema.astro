---
import { profile } from "@/i18n/content";
import { cv } from "@/i18n/cv";

const en = cv.en;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.shortName,
  email: profile.email,
  url: Astro.site?.toString(),
  image: new URL("/og.png", Astro.site).toString(),
  jobTitle: "Senior Full Stack Engineer (.NET / React)",
  description: en.profile,
  sameAs: [profile.github],
  knowsLanguage: ["Spanish", "English"],
  knowsAbout: [...new Set(en.skills.flatMap((group) => group.items))],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Santo Domingo",
    addressCountry: "DO",
  },
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(person)}></script>
