---
import { cvUi } from "@/i18n/cv";
import DownloadLink from "./DownloadLink.astro";
import LangSwitch from "./LangSwitch.astro";
---

<header class="sticky top-0 z-20 border-b border-line bg-desk pt-[env(safe-area-inset-top)] lg:hidden print:hidden">
  <div class="mx-auto flex h-14 max-w-[40rem] items-center gap-2 px-3 sm:px-5">
    <a href="/world" aria-label="AG World" class="grid size-11 shrink-0 place-items-center">
      <span class="grid size-7 place-items-center rounded-md border border-line font-meta text-meta text-ink">
        AG
      </span>
    </a>
    <p
      data-bar-label
      data-default={cvUi.title}
      class="min-w-0 flex-1 truncate font-meta text-meta text-ink-muted tabular-nums"
    >
      {cvUi.title}
    </p>
    <LangSwitch touch />
    <DownloadLink compact />
  </div>
  <span
    aria-hidden="true"
    class="progress-fill-x absolute inset-x-0 -bottom-px h-px origin-left bg-accent"
  ></span>
</header>
