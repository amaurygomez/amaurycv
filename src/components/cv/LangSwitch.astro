---
interface Props {
  touch?: boolean;
}

const { touch = false } = Astro.props;
const segment = touch ? "h-11 w-11" : "h-8 w-11";
---

<div
  role="group"
  aria-label="Idioma · Language"
  class="inline-flex rounded-lg border border-line p-0.5"
>
  <button
    type="button"
    data-lang-option="es"
    aria-pressed="true"
    aria-label="Español"
    lang="es"
    class:list={[
      "lang-option rounded-md font-meta text-meta transition-colors duration-150",
      segment,
    ]}
  >
    ES
  </button>
  <button
    type="button"
    data-lang-option="en"
    aria-pressed="false"
    aria-label="English"
    lang="en"
    class:list={[
      "lang-option rounded-md font-meta text-meta transition-colors duration-150",
      segment,
    ]}
  >
    EN
  </button>
</div>
