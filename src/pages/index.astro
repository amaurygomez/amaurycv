---
// Home: the brand page. AG World, the interactive portfolio, lives at /world.
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import PersonSchema from "@/components/astro/PersonSchema.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/home.css";
import "@/styles/home-hero.css";
import "@/styles/home-projects.css";

const title = "Amaury Gómez · Ingeniería de software";
const description =
  "Diseño, desarrollo y modernización de plataformas críticas para telecomunicaciones, gobierno y banca. Más de 11 años en producción continua con .NET, SQL Server y React.";
---

<BaseLayout
  title={title}
  description={description}
  lockScroll={false}
  bodyClass="home"
  colorScheme="light dark"
  themeColor="#FAFAF9"
  siteName="Amaury Gómez"
>
  <Fragment slot="head">
    <script is:inline>
      try {
        if (localStorage.getItem("ag-theme") === "dark") document.documentElement.dataset.theme = "dark";
      } catch {
        // Storage is unavailable in private mode; the light default stands.
      }
    </script>
    <PersonSchema />
  </Fragment>
  <a class="skip" href="#servicios" data-i="skip">Saltar al contenido</a>
  <header class="nav" id="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top" aria-label="Amaury Gómez · Ingeniería de software" data-i-aria="brand.aria">
        <svg class="mono-mark" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 26L10 6l7.5 20M6 19h8"/><path d="M28.95 11.05A7 7 0 1 0 31 16h-7"/></svg>
        <span><span class="wordmark">Amaury Gómez</span><span class="descriptor" data-i="brand.desc">Ingeniería de software</span></span>
      </a>
      <nav class="nav-links" aria-label="Principal" data-i-aria="nav.main">
        <a href="#servicios" data-spy="servicios" data-i="nav.services">Servicios</a>
        <a href="#proyectos" data-spy="proyectos" data-i="nav.projects">Proyectos</a>
        <a href="#enfoque" data-spy="enfoque" data-i="nav.approach">Enfoque</a>
        <a href="#proceso" data-spy="proceso" data-i="nav.process">Proceso</a>
        <a href="#fundador" data-spy="fundador" data-i="nav.founder">Fundador</a>
        <a href="#contacto" data-spy="contacto" data-i="nav.contact">Contacto</a>
        <span class="nav-ind" id="nav-ind" aria-hidden="true"></span>
      </nav>
      <div class="nav-actions">
        <div class="lang" role="group" aria-label="Idioma" data-i-aria="nav.lang">
          <button type="button" class="lang-btn" data-lang="es" aria-pressed="true">ES</button>
          <span class="lang-sep" aria-hidden="true">/</span>
          <button type="button" class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
        </div>
        <button type="button" class="icon-btn" id="theme-btn" aria-label="Cambiar tema" data-i-aria="nav.theme">
          <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="btn btn-primary btn-sm nav-cta" href="#contacto" data-i="nav.talk">Contactar</a>
        <button type="button" class="icon-btn menu-btn" id="menu-btn" aria-label="Abrir menú" data-i-aria="nav.menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="ico-bars" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="ico-x" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>
    <div class="mobile-menu" id="mobile-menu">
      <a href="#servicios" data-i="nav.services">Servicios</a>
      <a href="#proyectos" data-i="nav.projects">Proyectos</a>
      <a href="#enfoque" data-i="nav.approach">Enfoque</a>
      <a href="#proceso" data-i="nav.process">Proceso</a>
      <a href="#fundador" data-i="nav.founder">Fundador</a>
      <a href="#contacto" data-i="nav.contact">Contacto</a>
      <a class="btn btn-primary" href="#contacto" data-i="nav.talk">Contactar</a>
    </div>
    <span class="progress" id="progress" aria-hidden="true"></span>
  </header>

  <main id="top">
    <section class="hero" id="hero">
      <div class="hero-scene" id="hero-scene" aria-hidden="true"><canvas id="hero-canvas"></canvas></div>
      <div class="hero-veil" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="chip"><span class="dot" aria-hidden="true"></span><span data-i="hero.chip">Disponible para nuevos proyectos</span></p>
          <h1 class="hero-h1" id="hero-h1">Ingeniería de software para operaciones que no pueden detenerse.</h1>
          <p class="hero-sub" data-i="hero.sub">Diseño, desarrollo y modernización de plataformas críticas para telecomunicaciones, gobierno y banca. Más de 11 años en producción continua con .NET, SQL Server y React.</p>
          <div class="hero-cta">
            <a class="btn btn-primary" href="#proyectos"><span data-i="hero.cta1">Ver proyectos</span><svg class="arr" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
            <a class="btn btn-secondary" href="/cv#full-cv"><span data-i="hero.cta2">Solicitar currículum completo</span></a>
          </div>
          <div class="hero-trust">
            <span class="hero-trust-label" data-i="hero.trust">Sectores regulados</span>
            <ul class="hero-trust-list">
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1" fill="currentColor"/></svg><span data-i="hero.t1">Telecomunicaciones</span></li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M4 21V10M20 21V10M2 10l10-6 10 6M8 21v-7M12 21v-7M16 21v-7"/></svg><span data-i="hero.t2">Gobierno</span></li>
              <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span data-i="hero.t3">Banca</span></li>
            </ul>
          </div>
        </div>
        <aside class="hero-console" id="hero-console" aria-hidden="true">
          <div class="hc-head">
            <span class="hc-title"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg><span data-i="hc.title">Plataformas en producción</span></span>
            <span class="hc-live"><span class="hc-dot"></span><span data-i="hc.live">En vivo</span></span>
          </div>
          <ul class="hc-rows">
            <li class="hc-row" style="--i:0">
              <span class="hc-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z"/></svg></span>
              <span class="hc-txt"><span class="hc-name" data-i="hc.r1">CRM · Cobertura</span><span class="hc-sector" data-i="hc.s1">Telecomunicaciones</span></span>
              <span class="hc-state"><span class="hc-led"></span><span data-i="hc.ok">Operativo</span></span>
            </li>
            <li class="hc-row" style="--i:1">
              <span class="hc-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
              <span class="hc-txt"><span class="hc-name" data-i="hc.r2">Identidad · Middleware</span><span class="hc-sector" data-i="hc.s2">Gobierno</span></span>
              <span class="hc-state"><span class="hc-led"></span><span data-i="hc.ok">Operativo</span></span>
            </li>
            <li class="hc-row" style="--i:2">
              <span class="hc-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></span>
              <span class="hc-txt"><span class="hc-name" data-i="hc.r3">Calidad · Monitoreo</span><span class="hc-sector" data-i="hc.s3">Telecomunicaciones</span></span>
              <span class="hc-state"><span class="hc-led"></span><span data-i="hc.ok">Operativo</span></span>
            </li>
          </ul>
          <div class="hc-foot">
            <span class="hc-bars"><i style="--h:.45;--d:0s"></i><i style="--h:.7;--d:.15s"></i><i style="--h:.55;--d:.3s"></i><i style="--h:.85;--d:.45s"></i><i style="--h:.6;--d:.6s"></i><i style="--h:.95;--d:.75s"></i><i style="--h:.5;--d:.9s"></i><i style="--h:.75;--d:1.05s"></i><i style="--h:.65;--d:1.2s"></i><i style="--h:.9;--d:1.35s"></i><i style="--h:.4;--d:1.5s"></i><i style="--h:.8;--d:1.65s"></i></span>
            <span class="hc-note" data-i="hc.note">Operación 24/7 · auditoría activa</span>
          </div>
        </aside>
      </div>
      <div class="hero-scroll" aria-hidden="true"><span class="hero-scroll-line"></span><span class="hero-scroll-txt" data-i="hero.scroll">Desplazar</span></div>
    </section>

    <section class="metrics" aria-label="Métricas" data-i-aria="metrics.aria">
      <div class="wrap">
        <ul class="metric-grid">
          <li class="metric"><span class="num" data-target="11" data-suffix="+">11+</span><span class="label" data-i="m1">Años en producción</span></li>
          <li class="metric"><span class="num" data-target="24" data-suffix="/7">24/7</span><span class="label" data-i="m2">Operación continua</span></li>
          <li class="metric"><span class="num" data-target="3">3</span><span class="label" data-i="m3">Sectores regulados</span></li>
          <li class="metric"><span class="num" data-static>ES · EN</span><span class="label" data-i="m4">Atención bilingüe</span></li>
        </ul>
      </div>
    </section>

    <section class="section" id="servicios">
      <div class="wrap">
        <div class="sec-head">
          <div><span class="label" data-i="svc.eyebrow">Servicios</span><h2 class="reveal reveal-clip" data-i="svc.title">Servicios</h2><p class="sec-sub" data-i="svc.sub">Del diseño de la base de datos a la puesta en producción.</p></div>
        </div>
        <div class="svc-grid">
          <article class="svc reveal">
            <span class="idx">01</span>
            <div class="ico"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="i-stack" aria-hidden="true"><rect class="m1" x="6" y="6" width="28" height="8" rx="2"/><rect class="m2" x="6" y="16" width="28" height="8" rx="2"/><rect class="m3" x="6" y="26" width="28" height="8" rx="2"/><circle class="m4" cx="29" cy="20" r="1.6" fill="currentColor" stroke="none"/></svg></div>
            <h3 data-i="svc1.h">Plataformas críticas</h3>
            <p data-i="svc1.p">Sistemas que operan 24/7 con datos sensibles: diseño de arquitectura, API, interfaz y despliegue bajo una sola responsabilidad.</p>
          </article>
          <article class="svc reveal" style="--d:80ms">
            <span class="idx">02</span>
            <div class="ico"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="i-ref" aria-hidden="true"><path class="m1" d="M32 20a12 12 0 0 1-20.5 8.5M8 20A12 12 0 0 1 28.5 11.5"/><path class="m2" d="M28.5 6v5.5H23M11.5 34v-5.5H17"/></svg></div>
            <h3 data-i="svc2.h">Modernización de sistemas legados</h3>
            <p data-i="svc2.p">Migración progresiva a .NET moderno y contenedores sin interrumpir la operación.</p>
          </article>
          <article class="svc reveal" style="--d:160ms">
            <span class="idx">03</span>
            <div class="ico"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="i-link" aria-hidden="true"><rect class="m1" x="4" y="13" width="12" height="14" rx="3"/><rect class="m2" x="24" y="13" width="12" height="14" rx="3"/><path class="m3" d="M16 20h8"/><circle cx="10" cy="20" r="1.6" fill="currentColor" stroke="none"/><circle cx="30" cy="20" r="1.6" fill="currentColor" stroke="none"/></svg></div>
            <h3 data-i="svc3.h">Integraciones y APIs</h3>
            <p data-i="svc3.p">Conexión con servicios de terceros e instituciones, con tolerancia a fallos, caché de contingencia y trazabilidad.</p>
          </article>
          <article class="svc reveal" style="--d:240ms">
            <span class="idx">04</span>
            <div class="ico"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="i-data" aria-hidden="true"><ellipse class="m1" cx="14" cy="9" rx="9" ry="3.5"/><path d="M5 9v10c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9M5 19v10c0 1.9 4 3.5 9 3.5"/><path class="m2" d="M26 33v-6"/><path class="m3" d="M30.5 33v-9"/><path class="m4" d="M35 33V21"/></svg></div>
            <h3 data-i="svc4.h">Datos y rendimiento</h3>
            <p data-i="svc4.p">Modelado en SQL Server y Oracle, procedimientos almacenados y optimización de consultas.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="proyectos">
      <div class="wrap">
        <div class="sec-head">
          <div><span class="label" data-i="proj.eyebrow">Proyectos</span><h2 class="reveal reveal-clip" data-i="proj.title">Proyectos destacados</h2></div>
          <span class="sec-note" data-i="proj.note">Los nombres de los clientes se comparten bajo solicitud.</span>
        </div>
        <div class="story" id="story">
          <div class="story-stage">
            <nav class="story-rail" aria-label="Proyectos" data-i-aria="proj.eyebrow">
              <span class="story-count" aria-hidden="true"><span class="story-cur" id="story-cur">01</span><span class="story-sep">/ 03</span></span>
              <span class="story-bar" aria-hidden="true"></span>
              <ol class="story-index">
                <li><button type="button" class="story-jump" data-step="0" aria-current="true"><span class="n">01</span><span class="t" data-i="p1.h">Mapa de cobertura integrado en el CRM</span></button></li>
                <li><button type="button" class="story-jump" data-step="1"><span class="n">02</span><span class="t" data-i="p2.h">Servicio de identidad con continuidad ante fallos externos</span></button></li>
                <li><button type="button" class="story-jump" data-step="2"><span class="n">03</span><span class="t" data-i="p3.h">Monitoreo de calidad con trazabilidad por agente en tiempo real</span></button></li>
              </ol>
            </nav>

            <article class="story-item" id="proj-1">
              <div class="story-fig" data-chrome="crm / coverage-map">
                <svg class="dg" id="d1" viewBox="0 0 520 390" role="img" aria-label="Diagrama: mapa de cobertura por zonas" data-i-aria="d1.aria"></svg>
              </div>
              <div class="story-body">
                <span class="story-num">01 / 03</span>
                <span class="label" data-i="p1.tag">Telecomunicaciones · CRM · Geoespacial</span>
                <h3 data-i="p1.h">Mapa de cobertura integrado en el CRM</h3>
                <p data-i="p1.p">Ventas y soporte consultan, desde el mismo CRM, qué servicios fijos y móviles están disponibles en cada zona. Integra la API del proveedor de red y datos geoespaciales en Oracle; además, redujo el costo de Google Maps mediante la optimización de búsquedas e interacciones.</p>
                <ul class="stack"><li>.NET</li><li>Oracle</li><li>Angular</li><li>Google Maps</li></ul>
              </div>
            </article>

            <article class="story-item" id="proj-2">
              <div class="story-fig" data-chrome="identity / gateway">
                <svg class="dg" id="d2" viewBox="0 0 520 390" role="img" aria-label="Diagrama: capa intermedia de identidad con caché de contingencia" data-i-aria="d2.aria">
                  <defs>
                    <linearGradient id="g2-mw" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--primary)" stop-opacity=".10"/><stop offset=".3" stop-color="var(--primary)" stop-opacity="0"/></linearGradient>
                    <radialGradient id="g2-pk"><stop offset="0" stop-color="#fff" stop-opacity=".9"/><stop offset=".35" stop-color="var(--primary)"/><stop offset="1" stop-color="var(--primary)" stop-opacity="0"/></radialGradient>
                    <radialGradient id="g2-pka"><stop offset="0" stop-color="#fff" stop-opacity=".9"/><stop offset=".35" stop-color="var(--accent)"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></radialGradient>
                  </defs>
                  <path class="wire" id="d2-p1" d="M160 82 C 184 82, 184 118, 208 118"/>
                  <path class="wire" id="d2-p2" d="M160 195 L 208 195"/>
                  <path class="wire" id="d2-p3" d="M160 308 C 184 308, 184 272, 208 272"/>
                  <path class="wire" id="d2-p4" d="M368 195 L 408 195"/>
                  <path class="wire" id="d2-p5" d="M352 250 C 382 250, 382 206, 408 206"/>
                  <g class="flows" id="d2-flows">
                    <path class="wire-flow" d="M160 82 C 184 82, 184 118, 208 118"/>
                    <path class="wire-flow" d="M160 195 L 208 195"/>
                    <path class="wire-flow" d="M160 308 C 184 308, 184 272, 208 272"/>
                    <path class="wire-flow" d="M368 195 L 408 195"/>
                    <path class="wire-flow flow-acc" d="M352 250 C 382 250, 382 206, 408 206"/>
                  </g>
                  <g class="ext" id="d2-ext1">
                    <rect class="box" x="24" y="56" width="136" height="52" rx="10"/>
                    <circle class="led" cx="38" cy="70" r="3"/>
                    <text class="t-ink" x="92" y="86" text-anchor="middle" data-i="d2.api1">API · Identidad</text>
                  </g>
                  <g class="ext" id="d2-ext2">
                    <rect class="box" x="24" y="169" width="136" height="52" rx="10"/>
                    <circle class="led" cx="38" cy="183" r="3"/>
                    <text class="t-ink" x="92" y="199" text-anchor="middle" data-i="d2.api2">API · Huellas</text>
                    <text class="dn-label t-dn" x="92" y="243" text-anchor="middle" data-i="d2.down">Sin respuesta</text>
                  </g>
                  <g class="ext" id="d2-ext3">
                    <rect class="box" x="24" y="282" width="136" height="52" rx="10"/>
                    <circle class="led" cx="38" cy="296" r="3"/>
                    <text class="t-ink" x="92" y="312" text-anchor="middle" data-i="d2.api3">API · Registros</text>
                  </g>
                  <g id="d2-mw">
                    <rect class="box box-hero" x="208" y="44" width="160" height="302" rx="12"/>
                    <rect x="209" y="45" width="158" height="300" rx="11" fill="url(#g2-mw)"/>
                    <path class="shield" d="M288 54c-6 2.5-10 3.5-13 4v8c0 7 6 11.5 13 14 7-2.5 13-7 13-14v-8c-3-.5-7-1.5-13-4z"/>
                    <path class="shield-tick" d="M282.5 65.5l4 4 7-7"/>
                    <text class="t-ink t-lg" x="288" y="92" text-anchor="middle" data-i="d2.mw">Capa intermedia</text>
                    <rect class="pill" x="224" y="104" width="128" height="28" rx="7"/>
                    <text x="288" y="122" text-anchor="middle" data-i="d2.auth1">Identity · JWT</text>
                    <rect class="pill" x="224" y="138" width="128" height="28" rx="7"/>
                    <text x="288" y="156" text-anchor="middle" data-i="d2.auth2">Auditoría</text>
                    <g class="audit-rows">
                      <rect class="audit-row" x="232" y="176" width="112" height="3" rx="1.5" style="--w:.92;--d:0s"/>
                      <rect class="audit-row" x="232" y="184" width="112" height="3" rx="1.5" style="--w:.68;--d:.9s"/>
                      <rect class="audit-row" x="232" y="192" width="112" height="3" rx="1.5" style="--w:.80;--d:1.8s"/>
                      <rect class="audit-row" x="232" y="200" width="112" height="3" rx="1.5" style="--w:.55;--d:2.7s"/>
                    </g>
                    <line class="grid-line" x1="224" y1="210" x2="352" y2="210"/>
                  </g>
                  <g class="cache" id="d2-cache">
                    <rect class="box-soft" x="224" y="222" width="128" height="60" rx="9"/>
                    <path class="cache-ico" d="M282 238h12M282 243h12M282 248h8" />
                    <text x="288" y="270" text-anchor="middle" data-i="d2.cache">Caché local</text>
                  </g>
                  <g id="d2-app">
                    <rect class="box" x="408" y="169" width="88" height="52" rx="10"/>
                    <text class="t-ink" x="452" y="199" text-anchor="middle" data-i="d2.app">Aplicación</text>
