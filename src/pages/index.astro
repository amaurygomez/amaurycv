---
// Home: the brand page. AG World, the interactive portfolio, lives at /world.
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import PersonSchema from "@/components/astro/PersonSchema.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/home.css";

const title = "Amaury Gómez · Ingeniería de software";
const description =
  "Diseño, desarrollo y modernización de plataformas críticas para telecomunicaciones, gobierno y banca. Más de 11 años en producción continua con .NET, SQL Server y React.";
---

<BaseLayout
  title={title}
  description={description}
  lockScroll={false}
  bodyClass=""
  colorScheme="light dark"
  themeColor="#FAFAF9"
  siteName="Amaury Gómez"
>
  <Fragment slot="head">
    <script is:inline>
      try {
        if (localStorage.getItem("ag-theme") === "dark") document.documentElement.dataset.theme = "dark";
      } catch {
        // Storage is unavailable in private mode; the light default stands.
      }
    </script>
    <PersonSchema />
  </Fragment>
  <header class="nav" id="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="#top" aria-label="Amaury Gómez · Ingeniería de software" data-i-aria="brand.aria">
        <svg class="mono-mark" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 26L10 6l7.5 20M6 19h8"/><path d="M28.95 11.05A7 7 0 1 0 31 16h-7"/></svg>
        <span><span class="wordmark">Amaury Gómez</span><span class="descriptor" data-i="brand.desc">Ingeniería de software</span></span>
      </a>
      <nav class="nav-links" aria-label="Principal" data-i-aria="nav.main">
        <a href="#servicios" data-spy="servicios" data-i="nav.services">Servicios</a>
        <a href="#proyectos" data-spy="proyectos" data-i="nav.projects">Proyectos</a>
        <a href="#enfoque" data-spy="enfoque" data-i="nav.approach">Enfoque</a>
        <a href="#proceso" data-spy="proceso" data-i="nav.process">Proceso</a>
        <a href="#fundador" data-spy="fundador" data-i="nav.founder">Fundador</a>
        <a href="#contacto" data-spy="contacto" data-i="nav.contact">Contacto</a>
        <span class="nav-ind" id="nav-ind" aria-hidden="true"></span>
      </nav>
      <div class="nav-actions">
        <div class="lang" role="group" aria-label="Idioma" data-i-aria="nav.lang">
          <button type="button" class="lang-btn" data-lang="es" aria-pressed="true">ES</button>
          <span class="lang-sep" aria-hidden="true">/</span>
          <button type="button" class="lang-btn" data-lang="en" aria-pressed="false">EN</button>
        </div>
        <button type="button" class="icon-btn" id="theme-btn" aria-label="Cambiar tema" data-i-aria="nav.theme">
          <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="btn btn-primary btn-sm nav-cta" href="#contacto" data-i="nav.talk">Contactar</a>
        <button type="button" class="icon-btn menu-btn" id="menu-btn" aria-label="Abrir menú" data-i-aria="nav.menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="ico-bars" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="ico-x" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>
    <div class="mobile-menu" id="mobile-menu">
      <a href="#servicios" data-i="nav.services">Servicios</a>
      <a href="#proyectos" data-i="nav.projects">Proyectos</a>
      <a href="#enfoque" data-i="nav.approach">Enfoque</a>
      <a href="#proceso" data-i="nav.process">Proceso</a>
      <a href="#fundador" data-i="nav.founder">Fundador</a>
      <a href="#contacto" data-i="nav.contact">Contacto</a>
      <a class="btn btn-primary" href="#contacto" data-i="nav.talk">Contactar</a>
    </div>
  </header>

  <main id="top">
    <section class="hero" id="hero">
      <div class="hero-scene" id="hero-scene" aria-hidden="true"><canvas id="hero-canvas"></canvas></div>
      <div class="hero-veil" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="chip"><span class="dot" aria-hidden="true"></span><span data-i="hero.chip">Disponible para nuevos proyectos</span></p>
          <h1 class="hero-h1" id="hero-h1">Ingeniería de software para operaciones que no pueden detenerse.</h1>
          <p class="hero-sub" data-i="hero.sub">Diseño, desarrollo y modernización de plataformas críticas para telecomunicaciones, gobierno y banca. Más de 11 años en producción continua con .NET, SQL Server y React.</p>
          <div class="hero-cta">
            <a class="btn btn-primary" href="#proyectos"><span data-i="hero.cta1">Ver proyectos</span><svg class="arr" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
            <a class="btn btn-secondary" href="/cv#full-cv"><span data-i="hero.cta2">Solicitar currículum completo</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="metrics" aria-label="Métricas" data-i-aria="metrics.aria">
      <div class="wrap">
        <ul class="metric-grid">
          <li class="metric"><span class="num" data-target="11" data-suffix="+">11+</span><span class="label" data-i="m1">Años en producción</span></li>
          <li class="metric"><span class="num" data-target="24" data-suffix="/7">24/7</span><span class="label" data-i="m2">Operación continua</span></li>
          <li class="metric"><span class="num" data-target="3">3</span><span class="label" data-i="m3">Sectores regulados</span></li>
          <li class="metric"><span class="num" data-static>ES · EN</span><span class="label" data-i="m4">Atención bilingüe</span></li>
        </ul>
      </div>
    </section>

    <section class="section" id="servicios">
      <div class="wrap">
        <div class="sec-head">
          <div><span class="label" data-i="svc.eyebrow">Servicios</span><h2 class="reveal reveal-clip" data-i="svc.title">Servicios</h2><p class="sec-sub" data-i="svc.sub">Del diseño de la base de datos a la puesta en producción.</p></div>
        </div>
        <div class="svc-grid">
          <article class="svc reveal">
            <span class="idx">01</span>
            <div class="ico"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="i-stack" aria-hidden="true"><rect class="m1" x="6" y="6" width="28" height="8" rx="2"/><rect class="m2" x="6" y="16" width="28" height="8" rx="2"/><rect class="m3" x="6" y="26" width="28" height="8" rx="2"/><circle class="m4" cx="29" cy="20" r="1.6" fill="currentColor" stroke="none"/></svg></div>
            <h3 data-i="svc1.h">Plataformas críticas</h3>
            <p data-i="svc1.p">Sistemas que operan 24/7 con datos sensibles: diseño de arquitectura, API, interfaz y despliegue bajo una sola responsabilidad.</p>
          </article>
          <article class="svc reveal" style="--d:80ms">
            <span class="idx">02</span>
            <div class="ico"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="i-ref" aria-hidden="true"><path class="m1" d="M32 20a12 12 0 0 1-20.5 8.5M8 20A12 12 0 0 1 28.5 11.5"/><path class="m2" d="M28.5 6v5.5H23M11.5 34v-5.5H17"/></svg></div>
            <h3 data-i="svc2.h">Modernización de sistemas legados</h3>
            <p data-i="svc2.p">Migración progresiva a .NET moderno y contenedores sin interrumpir la operación.</p>
          </article>
          <article class="svc reveal" style="--d:160ms">
            <span class="idx">03</span>
            <div class="ico"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="i-link" aria-hidden="true"><rect class="m1" x="4" y="13" width="12" height="14" rx="3"/><rect class="m2" x="24" y="13" width="12" height="14" rx="3"/><path class="m3" d="M16 20h8"/><circle cx="10" cy="20" r="1.6" fill="currentColor" stroke="none"/><circle cx="30" cy="20" r="1.6" fill="currentColor" stroke="none"/></svg></div>
            <h3 data-i="svc3.h">Integraciones y APIs</h3>
            <p data-i="svc3.p">Conexión con servicios de terceros e instituciones, con tolerancia a fallos, caché de contingencia y trazabilidad.</p>
          </article>
          <article class="svc reveal" style="--d:240ms">
            <span class="idx">04</span>
            <div class="ico"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="i-data" aria-hidden="true"><ellipse class="m1" cx="14" cy="9" rx="9" ry="3.5"/><path d="M5 9v10c0 1.9 4 3.5 9 3.5s9-1.6 9-3.5V9M5 19v10c0 1.9 4 3.5 9 3.5"/><path class="m2" d="M26 33v-6"/><path class="m3" d="M30.5 33v-9"/><path class="m4" d="M35 33V21"/></svg></div>
            <h3 data-i="svc4.h">Datos y rendimiento</h3>
            <p data-i="svc4.p">Modelado en SQL Server y Oracle, procedimientos almacenados y optimización de consultas.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="proyectos">
      <div class="wrap">
        <div class="sec-head">
          <div><span class="label" data-i="proj.eyebrow">Proyectos</span><h2 class="reveal reveal-clip" data-i="proj.title">Proyectos destacados</h2></div>
          <span class="sec-note" data-i="proj.note">Los nombres de los clientes se comparten bajo solicitud.</span>
        </div>
        <div class="proj-list">
          <article class="proj">
            <div class="proj-fig">
              <svg class="dg" id="d1" viewBox="0 0 520 340" role="img" aria-label="Diagrama: mapa de cobertura por zonas" data-i-aria="d1.aria"></svg>
            </div>
            <div class="proj-body reveal">
              <span class="idx">01 / 03</span>
              <span class="label" data-i="p1.tag">Telecomunicaciones · CRM · Geoespacial</span>
              <h3 data-i="p1.h">Mapa de cobertura integrado en el CRM</h3>
              <p data-i="p1.p">Ventas y soporte consultan, desde el mismo CRM, qué servicios fijos y móviles están disponibles en cada zona. Integra la API del proveedor de red y datos geoespaciales en Oracle; además, redujo el costo de Google Maps mediante la optimización de búsquedas e interacciones.</p>
              <ul class="stack"><li>.NET</li><li>Oracle</li><li>Angular</li><li>Google Maps</li></ul>
            </div>
          </article>
          <article class="proj">
            <div class="proj-fig">
              <svg class="dg" id="d2" viewBox="0 0 520 340" role="img" aria-label="Diagrama: capa intermedia de identidad con caché de contingencia" data-i-aria="d2.aria">
                <g class="ext" id="d2-ext1">
                  <rect class="box" x="20" y="46" width="136" height="48" rx="6"/>
                  <text x="88" y="74" text-anchor="middle" style="font-size:10px" data-i="d2.api1">API · Identidad</text>
                </g>
                <g class="ext" id="d2-ext2">
                  <rect class="box" x="20" y="146" width="136" height="48" rx="6"/>
                  <text x="88" y="174" text-anchor="middle" style="font-size:10px" data-i="d2.api2">API · Huellas</text>
                  <text class="dn-label t-dn" x="88" y="212" text-anchor="middle" data-i="d2.down">Sin respuesta</text>
                </g>
                <g class="ext" id="d2-ext3">
                  <rect class="box" x="20" y="246" width="136" height="48" rx="6"/>
                  <text x="88" y="274" text-anchor="middle" style="font-size:10px" data-i="d2.api3">API · Registros</text>
                </g>
                <path class="wire" id="d2-p1" d="M156 70 C 181 70, 181 110, 206 110"/>
                <path class="wire" id="d2-p2" d="M156 170 L 206 170"/>
                <path class="wire" id="d2-p3" d="M156 270 C 181 270, 181 230, 206 230"/>
                <rect class="box" x="206" y="60" width="150" height="220" rx="8"/>
                <text class="t-ink" x="281" y="88" text-anchor="middle" style="font-size:10px" data-i="d2.mw">Capa intermedia</text>
                <text x="281" y="108" text-anchor="middle" style="font-size:9px" data-i="d2.auth1">Identity · JWT</text>
                <text x="281" y="124" text-anchor="middle" style="font-size:9px" data-i="d2.auth2">Auditoría</text>
                <line class="grid-line" x1="222" y1="144" x2="340" y2="144"/>
                <g class="cache" id="d2-cache">
                  <rect class="box-soft" x="222" y="196" width="118" height="60" rx="6"/>
                  <text x="281" y="230" text-anchor="middle" data-i="d2.cache">Caché local</text>
                </g>
                <path class="wire" id="d2-p4" d="M356 170 L 406 170"/>
                <path class="wire" id="d2-p5" d="M340 226 C 380 226, 380 186, 406 182"/>
                <rect class="box" x="406" y="142" width="94" height="56" rx="6"/>
                <text class="t-ink" x="453" y="174" text-anchor="middle" data-i="d2.app">Aplicación</text>
                <text class="served t-acc" id="d2-served" x="453" y="226" text-anchor="middle" style="font-size:9px" data-i="d2.served">Servido desde caché</text>
                <g id="d2-pk"></g>
              </svg>
            </div>
            <div class="proj-body reveal">
              <span class="idx">02 / 03</span>
              <span class="label" data-i="p2.tag">Gobierno · Identidad · Seguridad</span>
              <h3 data-i="p2.h">Servicio de identidad con continuidad ante fallos externos</h3>
              <p data-i="p2.p">Capa intermedia frente a las APIs de identidad y huellas dactilares de otras instituciones, con caché local de contingencia. Permisos por perfil con ASP.NET Core Identity y JWT, y auditoría de cada consulta a datos sensibles.</p>
              <ul class="stack"><li>ASP.NET Core</li><li>SQL Server</li><li>Redis</li><li>React</li></ul>
            </div>
          </article>
          <article class="proj">
            <div class="proj-fig">
              <svg class="dg" id="d3" viewBox="0 0 520 340" role="img" aria-label="Diagrama: panel de calidad en tiempo real" data-i-aria="d3.aria">
                <circle class="rec" id="d3-rec" cx="28" cy="30" r="4"/>
                <text x="42" y="34"><tspan data-i="d3.rec">Grabando</tspan> · <tspan data-i="d3.agent">Agente</tspan> 03</text>
                <text class="t-ink" id="d3-timer" x="496" y="34" text-anchor="end">00:12:37</text>
                <line class="wave-bg" x1="24" y1="86" x2="496" y2="86"/>
                <polyline class="wave" id="d3-wave" points="24,86 496,86"/>
                <line class="grid-line" x1="16" y1="128" x2="504" y2="128"/>
                <g class="row" data-row="0"><rect class="row-bg" x="16" y="136" width="488" height="34" rx="6"/><circle class="st s1" cx="32" cy="153" r="4"/><text class="t-ink" x="46" y="157"><tspan data-i="d3.agent">Agente</tspan> 01</text><text class="st-l" x="190" y="157" data-i="d3.s1">En llamada</text><g class="lv" transform="translate(330 148)"></g></g>
                <g class="row" data-row="1"><rect class="row-bg" x="16" y="180" width="488" height="34" rx="6"/><circle class="st s2" cx="32" cy="197" r="4"/><text class="t-ink" x="46" y="201"><tspan data-i="d3.agent">Agente</tspan> 02</text><text class="st-l" x="190" y="201" data-i="d3.s2">Disponible</text><g class="lv" transform="translate(330 192)"></g></g>
                <g class="row live" data-row="2"><rect class="row-bg" x="16" y="224" width="488" height="34" rx="6"/><circle class="st s3" cx="32" cy="241" r="4"/><text class="t-ink" x="46" y="245"><tspan data-i="d3.agent">Agente</tspan> 03</text><text class="st-l" x="190" y="245" data-i="d3.s3">En revisión</text><g class="lv" transform="translate(330 236)"></g></g>
                <g class="row" data-row="3"><rect class="row-bg" x="16" y="268" width="488" height="34" rx="6"/><circle class="st s1" cx="32" cy="285" r="4"/><text class="t-ink" x="46" y="289"><tspan data-i="d3.agent">Agente</tspan> 04</text><text class="st-l" x="190" y="289" data-i="d3.s1">En llamada</text><g class="lv" transform="translate(330 280)"></g></g>
                <text x="16" y="326" data-i="d3.title">Panel de calidad · en vivo</text>
              </svg>
            </div>
            <div class="proj-body reveal">
              <span class="idx">03 / 03</span>
              <span class="label" data-i="p3.tag">Telecomunicaciones · Calidad · Tiempo real</span>
              <h3 data-i="p3.h">Monitoreo de calidad con trazabilidad por agente en tiempo real</h3>
              <p data-i="p3.p">Captura de pantalla y voz con FFmpeg, API REST y panel en tiempo real con SignalR para el área de calidad.</p>
              <ul class="stack"><li>.NET</li><li>SignalR</li><li>FFmpeg</li><li>REST</li></ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="enfoque">
      <div class="wrap">
        <div class="sec-head">
          <div><span class="label" data-i="how.eyebrow">Enfoque</span><h2 class="reveal reveal-clip" data-i="how.title">Enfoque</h2></div>
        </div>
        <div class="how-grid">
          <div class="how reveal"><span class="label">01</span><h3 data-i="how1.h">Responsabilidad de extremo a extremo</h3><p data-i="how1.p">Una sola persona responsable de cada funcionalidad: esquema, procedimientos, API, interfaz y despliegue.</p></div>
          <div class="how reveal" style="--d:90ms"><span class="label">02</span><h3 data-i="how2.h">Continuidad operativa</h3><p data-i="how2.p">Modernización de sistemas en producción sin detener la operación, con integración y despliegue continuos.</p></div>
          <div class="how reveal" style="--d:180ms"><span class="label">03</span><h3 data-i="how3.h">Seguridad y cumplimiento</h3><p data-i="how3.p">Permisos por perfil, auditoría y ambientes restringidos para datos de gobierno y banca.</p></div>
        </div>
      </div>
    </section>

    <section class="section" id="proceso">
      <div class="wrap">
        <div class="sec-head">
          <div><span class="label" data-i="proc.eyebrow">Proceso</span><h2 class="reveal reveal-clip" data-i="proc.title">Cómo trabajamos</h2><p class="sec-sub" data-i="proc.sub">Ocho pasos, de la solicitud al soporte. Cada uno con responsable y tiempo definidos.</p></div>
        </div>
        <ol class="steps" id="steps">
          <li class="step"><span class="rail" aria-hidden="true"><span class="rail-fill"></span><span class="head"></span></span><span class="node" aria-hidden="true"></span><span class="s-num">01</span><h3 data-i="st1.h">Solicitud</h3><p data-i="st1.p">Formulario con el tipo de sistema, sector, estado del sistema, plazo y presupuesto estimado.</p><span class="s-meta" data-i="st1.m">Cliente · 5 min</span></li>
          <li class="step"><span class="rail" aria-hidden="true"><span class="rail-fill"></span><span class="head"></span></span><span class="node" aria-hidden="true"></span><span class="s-num">02</span><h3 data-i="st2.h">Análisis asistido por IA</h3><p data-i="st2.p">Resumen, clasificación, complejidad estimada, riesgos y preguntas clave. La IA prepara; no decide.</p><span class="s-meta" data-i="st2.m">Automático · minutos</span></li>
          <li class="step"><span class="rail" aria-hidden="true"><span class="rail-fill"></span><span class="head"></span></span><span class="node" aria-hidden="true"></span><span class="s-num">03</span><h3 data-i="st3.h">Revisión del fundador</h3><p data-i="st3.p">Cada solicitud se revisa personalmente antes de avanzar.</p><span class="s-meta" data-i="st3.m">Fundador · 24–48 h</span></li>
          <li class="step"><span class="rail" aria-hidden="true"><span class="rail-fill"></span><span class="head"></span></span><span class="node" aria-hidden="true"></span><span class="s-num">04</span><h3 data-i="st4.h">Llamada inicial</h3><p data-i="st4.p">Conversación breve para confirmar necesidad, plazo y presupuesto. Agenda en horario de EE. UU.</p><span class="s-meta" data-i="st4.m">20 min · sin costo</span></li>
          <li class="step"><span class="rail" aria-hidden="true"><span class="rail-fill"></span><span class="head"></span></span><span class="node" aria-hidden="true"></span><span class="s-num">05</span><h3 data-i="st5.h">Diagnóstico y propuesta</h3><p data-i="st5.p">Análisis técnico bajo acuerdo de confidencialidad. Su costo depende de la magnitud y se acredita al proyecto si se contrata.</p><span class="s-meta" data-i="st5.m">Pagado · acreditable</span></li>
          <li class="step"><span class="rail" aria-hidden="true"><span class="rail-fill"></span><span class="head"></span></span><span class="node" aria-hidden="true"></span><span class="s-num">06</span><h3 data-i="st6.h">Contrato y anticipo</h3><p data-i="st6.p">Firma digital del contrato, cesión de propiedad intelectual al pago y anticipo antes de iniciar.</p><span class="s-meta" data-i="st6.m">Firma digital</span></li>
