---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SeoCv from "@/components/astro/SeoCv.astro";
import PersonSchema from "@/components/astro/PersonSchema.astro";
import WorldApp from "@/world/WorldApp.tsx";

const title =
  "Amaury Gómez · Senior Software Engineer · Enterprise Systems & Operational Platforms";
const description =
  "Ingeniero de software senior desde Santo Domingo, RD, con más de 11 años construyendo y manteniendo plataformas empresariales en telecomunicaciones, banca, sector público y software transaccional. .NET, React, Java, Oracle, SQL Server, mapas, APIs y modernización de sistemas legados. AG World: portafolio interactivo.";
---

<BaseLayout title={title} description={description} lang="es">
  <PersonSchema slot="head" />
  <SeoCv />
  <WorldApp client:only="react" />
</BaseLayout>
