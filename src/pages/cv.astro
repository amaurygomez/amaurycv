---
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import PersonSchema from "@/components/astro/PersonSchema.astro";
import CvBar from "@/components/cv/CvBar.astro";
import CvDocument from "@/components/cv/CvDocument.astro";
import CvRail from "@/components/cv/CvRail.astro";
import Localized from "@/components/cv/Localized.astro";
import RequestDialog from "@/components/cv/RequestDialog.astro";
import { cvLangs, cvUi, sourceUrl } from "@/i18n/cv";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/cv.css";

const description =
  "CV de Amaury Gómez, desarrollador full stack senior (.NET, React, SQL Server). Versión web y PDF en español e inglés.";
---

<BaseLayout title={cvUi.title} description={description} lockScroll={false}>
  <Fragment slot="head">
    <script is:inline>
      (() => {
        const query = new URLSearchParams(location.search).get("lang");
        let stored = null;
        try {
          stored = localStorage.getItem("amaurycv-lang");
        } catch {
          // Storage is unavailable in private mode; the query and navigator still decide.
        }
        const pick = (value) => (value === "es" || value === "en" ? value : null);
        const lang =
          pick(query) ??
          pick(stored) ??
          (navigator.language.toLowerCase().startsWith("es") ? "es" : "en");
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
      })();
    </script>
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <PersonSchema />
  </Fragment>

  <a
    href="#cv"
    class="sr-only rounded-md bg-accent text-small font-semibold text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2.5 print:hidden"
  >
    <Localized text={cvUi.skip} />
  </a>

  <CvBar />

  <div class="cv-layout mx-auto max-w-[40rem] px-5 lg:grid lg:max-w-[76rem] lg:grid-cols-[14rem_minmax(0,44rem)] lg:justify-center lg:gap-x-20 lg:px-10 lg:pt-10 print:max-w-none print:p-0">
    <CvRail />

    <main id="cv" tabindex="-1" class="pt-6 pb-(--sp-section) outline-none lg:pt-0 print:p-0">
      <a
        href="/"
        class="inline-flex h-11 items-center font-meta text-meta text-ink-muted lg:hidden print:hidden"
      >
        ← AG World
      </a>

      {cvLangs.map((lang) => (
        <CvDocument lang={lang} />
      ))}

      <section
        id="full-cv"
        aria-labelledby="full-cv-title"
        class="mt-(--sp-section) scroll-mt-20 border-t border-line pt-10 lg:scroll-mt-10 print:hidden"
      >
        <p class="font-meta text-meta tracking-[0.16em] text-ink-faint uppercase">
          <Localized text={cvUi.requestSection.eyebrow} />
        </p>
        <h2
          id="full-cv-title"
          class="mt-4 text-[1.25rem] font-medium tracking-[-0.01em] text-balance text-ink"
        >
          <Localized text={cvUi.requestSection.title} />
        </h2>
        <p class="mt-2 max-w-[52ch] text-body text-ink-muted">
          <Localized text={cvUi.requestSection.text} />
        </p>
        <button
          type="button"
          data-request-open
          class="mt-7 inline-flex h-11 w-full items-center justify-center gap-2 rounded-lg bg-accent px-5 text-small font-semibold text-on-accent transition-opacity duration-150 hover:opacity-90 sm:w-auto"
        >
          <Localized text={cvUi.request} />
          <span aria-hidden="true">→</span>
        </button>
      </section>
    </main>

    <footer class="border-t border-line py-10 font-meta text-meta leading-relaxed text-ink-faint lg:col-start-2 print:hidden">
      <p>
        <Localized text={cvUi.colophon} /> <Localized text={cvUi.source} />:{" "}
        <a class="cv-link" href={sourceUrl}>
          github.com/amaurygomez/amaurycv
        </a>
      </p>
      <p class="mt-2">
        <a class="cv-link" href="/">
          ← AG World
        </a>
      </p>
    </footer>
  </div>

  <RequestDialog />
</BaseLayout>

<script>
  import "@/scripts/cv/page";
</script>
